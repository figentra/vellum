{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "//#check:boundaries",
        "//#check:marketplace"
      ]
    },
    "//#check:boundaries": {
      "inputs": [
        "scripts/check-boundaries.mjs",
        "pnpm-workspace.yaml",
        "**/package.json",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#check:marketplace": {
      "dependsOn": [
        "@vellum/plugin-claude#build"
      ],
      "inputs": [
        "scripts/marketplace.mjs",
        "plugins/claude/**",
        ".claude-plugin/marketplace.json",
        "packages/plugin-claude/dist/**"
      ],
      "outputs": []
    }
  },
  "boundaries": {
    "tags": {
      "tooling": {
        "dependencies": {
          "allow": []
        }
      },
      "protocol": {
        "dependencies": {
          "allow": [
            "tooling"
          ]
        }
      },
      "engine": {
        "dependencies": {
          "allow": [
            "protocol",
            "tooling"
          ]
        }
      },
      "storage": {
        "dependencies": {
          "allow": [
            "protocol",
            "engine",
            "tooling"
          ]
        }
      },
      "renderers": {
        "dependencies": {
          "allow": [
            "protocol",
            "engine",
            "tooling"
          ]
        }
      },
      "cli": {
        "dependencies": {
          "allow": [
            "protocol",
            "engine",
            "storage",
            "renderers",
            "tooling"
          ]
        }
      },
      "mcp": {
        "dependencies": {
          "allow": [
            "protocol",
            "engine",
            "storage",
            "renderers",
            "tooling"
          ]
        }
      },
      "method": {
        "dependencies": {
          "allow": []
        }
      },
      "plugin": {
        "dependencies": {
          "allow": [
            "method",
            "renderers",
            "engine",
            "protocol",
            "tooling"
          ]
        }
      },
      "vellum": {
        "dependencies": {
          "allow": [
            "cli",
            "mcp",
            "protocol",
            "engine",
            "storage",
            "renderers",
            "tooling"
          ]
        }
      },
      "testing": {
        "dependencies": {
          "allow": [
            "protocol",
            "engine",
            "storage",
            "renderers",
            "cli",
            "mcp",
            "vellum",
            "method",
            "plugin",
            "tooling"
          ]
        }
      }
    }
  }
}
