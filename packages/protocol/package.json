{
  "name": "@vellum/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Vellum protocol — contract types and JSON schemas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .tsbuildinfo coverage"
  },
  "devDependencies": {
    "@vellum/tsconfig": "workspace:*"
  },
  "dependencies": {}
}
