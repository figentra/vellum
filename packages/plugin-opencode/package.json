{
  "name": "@vellum/plugin-opencode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenCode plugin package — assembled from @vellum/method",
  "files": ["dist"],
  "scripts": {
    "build": "echo 'Builds OpenCode plugin from method + renderers'",
