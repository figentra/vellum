{
  "name": "@vellum/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vellum testing utilities — fixture-repo builder, conformance harness",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .tsbuildinfo coverage"
  },
  "devDependencies": {
    "@vellum/tsconfig": "workspace:*",
    "@vellum/protocol": "workspace:*",
    "@vellum/engine": "workspace:*",
    "@vellum/storage": "workspace:*",
    "@vellum/renderers": "workspace:*",
    "@vellum/cli": "workspace:*",
    "@vellum/mcp": "workspace:*"
  }
}
