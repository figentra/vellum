{
  "name": "@vellum/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end suite: drives the packed @figentra/vellum tarball, installed offline, against temp git repositories",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "clean": "rm -rf coverage"
  },
  "devDependencies": {
    "@figentra/vellum": "workspace:*",
    "@vellum/renderers": "workspace:*",
    "@vellum/tsconfig": "workspace:*",
    "@vellum/vitest-config": "workspace:*"
  }
}
