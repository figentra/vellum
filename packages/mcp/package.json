{
  "name": "@vellum/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vellum MCP server — read-only Model Context Protocol server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vellum-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .tsbuildinfo coverage"
  },
  "dependencies": {
    "@vellum/protocol": "workspace:*",
    "@vellum/engine": "workspace:*",
    "@vellum/storage": "workspace:*",
    "@vellum/renderers": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@vellum/tsconfig": "workspace:*"
  }
}
