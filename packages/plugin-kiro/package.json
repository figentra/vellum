{
  "name": "@vellum/plugin-kiro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kiro Power plugin \u2014 assembled from @vellum/method",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
