{
  "name": "vellum-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Vellum — Specification lifecycle enforcement for AI-assisted development",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxlint --fix && prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "check:marketplace": "node scripts/marketplace.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@types/node": "^22.15.21",
    "oxlint": "^1.5.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "vitest": "catalog:"
  }
}
